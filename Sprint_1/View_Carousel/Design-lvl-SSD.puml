@startuml

title View Carousel Use Case Squence Diagram

actor User 

participant ReactApplication as "<<View>>\nReactApplication"
participant HomePage as "<<View>>\nHomePage"

participant GalleryController as "<<Controller>>\nGalleryController"

participant GalleryService as "<<Service>>\nGalleryService"

participant GalleryRepository as "<<Repository>>\nGalleryRepository"

participant Database as "<<Database>>\nDatabase"

participant GalleryResponseMapper as "<<Mapper>>\nGalleryResponseMapper"

User -> ReactApplication : GET /
activate ReactApplication

ReactApplication -> HomePage : render()
activate HomePage



HomePage -> GalleryController : GET /galleries
activate GalleryController 





GalleryController -> GalleryService : getGallery()
activate GalleryService 


GalleryService -> GalleryRepository : findAll()
activate GalleryRepository


GalleryRepository -> Database : SELECT * FROM gallery
activate Database

Database --> GalleryService : Galleries

deactivate GalleryRepository

deactivate Database



GalleryService -> GalleryResponseMapper : toGalleryResponse(Galleries)
activate GalleryResponseMapper

GalleryResponseMapper --> GalleryService : GalleryResponse

deactivate GalleryResponseMapper

GalleryService --> GalleryController : GalleryResponse

deactivate GalleryService

GalleryController --> HomePage : GalleryResponse

deactivate GalleryController

HomePage --> User : Carousel

deactivate HomePage


@endpuml
