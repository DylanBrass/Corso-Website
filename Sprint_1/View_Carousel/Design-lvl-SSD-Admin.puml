@startuml

actor Admin 

participant ReactApplication as "<<View>> ReactApplication"
activate ReactApplication

Admin -> ReactApplication : GET /

participant Dashboard as "<<View>> Dashboard"

participant GalleryAdminPage as "<<View>> GalleryAdminPage"

participant EditGalleryPage as "<<View>> EditGalleryPage"

participant GalleryController as "<<Controller>> GalleryController"

participant GalleryService as "<<Service>> GalleryService"

participant GalleryRepository as "<<Repository>> GalleryRepository"

participant Database as "<<Database>> Database"

participant GalleryRequestMapper as "<<Mapper>> GalleryRequestMapper"

participant GalleryResponseMapper as "<<Mapper>> GalleryResponseMapper"

Admin -> ReactApplication : GET /dashboard

ReactApplication -> Dashboard : render()
activate Dashboard
Admin -> Dashboard : ManageGalleries()

Dashboard -> ReactApplication : GET /ManageGalleries

deactivate Dashboard

ReactApplication -> GalleryAdminPage : render()
activate GalleryAdminPage

GalleryAdminPage -> GalleryController : GET /galleries
activate GalleryController


GalleryController -> GalleryService : getGalleries()
activate GalleryService


GalleryService -> GalleryRepository : findAll()
activate GalleryRepository


GalleryRepository -> Database : SELECT * FROM gallery
activate Database

Database --> GalleryRepository : Gallery

deactivate Database

GalleryRepository --> GalleryService : List<Gallery>

deactivate GalleryRepository


GalleryService -> GalleryResponseMapper : ToGalleryResponses(List<Gallery>)
activate GalleryResponseMapper

GalleryResponseMapper --> GalleryService : List<GalleryResponse>

deactivate GalleryResponseMapper

GalleryService --> GalleryController : List<GalleryResponse>

deactivate GalleryService

GalleryController --> GalleryAdminPage : List<GalleryResponse>

deactivate GalleryController


GalleryAdminPage --> Admin : ShowListOfGalleries()

Admin -> GalleryAdminPage : ClickEditGalleryButton(String {id})



    GalleryAdminPage -> ReactApplication : GET /Dashboard/edit-gallery

    GalleryAdminPage -> EditGalleryPage : render()

    deactivate GalleryAdminPage

    activate EditGalleryPage



    EditGalleryPage -> GalleryController : GET /galleries/{id}
    activate GalleryController


    GalleryController -> GalleryService : getGallery(String {id})
    activate GalleryService


    GalleryService -> GalleryRepository : findGalleryByGalleryId(String galleryId)
    activate GalleryRepository


    GalleryRepository -> Database : SELECT * FROM gallery WHERE galleryId = {id}
    activate Database

    Database --> GalleryRepository : Gallery

    deactivate Database

    GalleryRepository --> GalleryService : Gallery

    deactivate GalleryRepository


    GalleryService -> GalleryResponseMapper : ToGalleryResponse(Gallery gallery)
    activate GalleryResponseMapper

    GalleryResponseMapper --> GalleryService : GalleryResponse

    deactivate GalleryResponseMapper

    GalleryService --> GalleryController : GalleryResponse

    deactivate GalleryService

    GalleryController --> EditGalleryPage : GalleryResponse

    deactivate GalleryController



    EditGalleryPage --> Admin : EditGalleryForm()

    Admin -> EditGalleryPage : SubmitEditGalleryForm()

    EditGalleryPage -> GalleryController : PUT /galleries/{id}

    activate GalleryController



    GalleryController -> GalleryService : updateGallery(String {id}, GalleryRequest galleryRequest)
    activate GalleryService


    GalleryService -> GalleryService : getGallery(String galleryId)

    GalleryService -> GalleryRepository : findGalleryByGalleryId(String galleryId)
    activate GalleryRepository


    GalleryRepository -> Database : SELECT * FROM gallery WHERE galleryId = {id}
    activate Database

    Database --> GalleryRepository : Gallery

    deactivate Database

    GalleryRepository --> GalleryService : Gallery

    deactivate GalleryRepository


    GalleryService -> GalleryRequestMapper : ToGallery(GalleryRequest galleryRequest)
    activate GalleryRequestMapper


    GalleryRequestMapper --> GalleryService : Gallery

    deactivate GalleryRequestMapper
    


    GalleryService -> GalleryResponseMapper : ToGalleryResponse(Gallery)
    activate GalleryResponseMapper

    GalleryResponseMapper --> GalleryService : GalleryResponse

    deactivate GalleryResponseMapper

    GalleryService --> GalleryController : GalleryResponse

    deactivate GalleryService

    GalleryController --> EditGalleryPage : GalleryResponse

    deactivate GalleryController

    EditGalleryPage --> Admin : ShowSavedAlert()

    Admin -> EditGalleryPage : ClickDeleteGalleryButton(String {id})

    EditGalleryPage -> GalleryController : DELETE /galleries/{id}

    activate GalleryController

    GalleryController -> GalleryService : deleteGallery(String {id})

    activate GalleryService

    GalleryService -> GalleryRepository : deleteGalleryByGalleryId(String galleryId)

    activate GalleryRepository

    GalleryRepository -> Database : DELETE FROM gallery WHERE galleryId = {id}

    activate Database

    Database --> GalleryRepository : Gallery

    deactivate Database

    GalleryRepository --> GalleryService : Gallery

    deactivate GalleryRepository


    GalleryService -> GalleryResponseMapper : ToGalleryResponse(Gallery gallery)

    activate GalleryResponseMapper

    GalleryResponseMapper --> GalleryService : GalleryResponse

    deactivate GalleryResponseMapper

    GalleryService --> GalleryController : GalleryResponse

    deactivate GalleryService


    GalleryController --> EditGalleryPage : GalleryResponse

    deactivate GalleryController

    EditGalleryPage --> Admin : ShowDeletedAlert()

    deactivate EditGalleryPage

@endpuml
