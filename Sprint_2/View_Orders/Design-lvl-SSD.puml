@startuml

title View Carousel Use Case Sequence Diagram

actor Customer

participant ReactApplication as "<<View>> ReactApplication"
participant RequestOrderPage as "<<View>> RequestOrderPage"
participant AccountPage as "<<View>> AccountPage"


participant OrderController as "<<Controller>> OrderController"

participant OrderService as "<<Service>> OrderService"

participant OrderRepository as "<<Repository>> OrderRepository"

participant Database as "<<Database>> Database"

participant OrderResponseMapper as "<<Mapper>> OrderResponseMapper"

Customer -> ReactApplication : GET /
activate ReactApplication

ReactApplication -> AccountPage : render()
activate AccountPage



AccountPage -> OrderController : GET /orders/customers/{customer_id}
activate OrderController




 OrderController -> OrderService : getOrdersByCustomerId()
activate OrderService

 OrderService -> OrderRepository : findOrdersByCustomerId()
activate OrderRepository

 OrderRepository -> Database : SELECT * FROM orders WHERE customer_id = {customer_id}
activate Database

Database --> OrderService : Orders

deactivate OrderRepository

deactivate Database


OrderService -> OrderResponseMapper : toOrderResponse(Orders)
activate OrderResponseMapper

OrderResponseMapper --> OrderService : OrderResponse

deactivate OrderResponseMapper
 OrderService --> OrderController : OrderResponse

deactivate OrderService
 OrderController --> AccountPage : OrderResponse

deactivate OrderController

AccountPage --> Customer : showCustomerOrders()

deactivate AccountPage

Customer -> RequestOrderPage : requestAnOrder()
activate RequestOrderPage

RequestOrderPage -> OrderController : POST /orders
activate OrderController

OrderController -> OrderService : createOrder()
activate OrderService

OrderService -> OrderRepository : saveOrder()
activate OrderRepository

OrderRepository -> Database : INSERT INTO orders (customer_id, service_id, order_date, order_status) VALUES ({customer_id}, {service_id}, {order_date}, {order_status})
activate Database

Database --> OrderRepository : Order

deactivate Database

OrderRepository --> OrderService : Order

deactivate OrderRepository

OrderService -> OrderRequestMapper : toOrder(OrderRequest orderRequest)
activate OrderRequestMapper

OrderRequestMapper --> OrderService : Order

deactivate OrderRequestMapper

OrderService -> OrderResponseMapper : toOrderResponse(Order order)
activate OrderResponseMapper

OrderResponseMapper --> OrderService : OrderResponse

deactivate OrderResponseMapper

OrderService --> OrderController : OrderResponse

deactivate OrderService

OrderController --> RequestOrderPage : OrderResponse

deactivate OrderController

RequestOrderPage --> Customer : showOrderConfirmation()

deactivate RequestOrderPage


@endpuml
