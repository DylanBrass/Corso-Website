@startuml

title Choose Review to Pin of Reviews SSD

actor Admin

participant Dashboard as "<<View>>\nDashboard"

participant ChooseViewableReviews as "<<View>>\nTestimonies"

participant ReviewRequest as "reviewRequest: ReviewRequest"

participant ReviewController as "<<Controller>>\nReviewController"

participant ReviewResponse as "response: ReviewResponse"

participant ReviewService as "<<Service>>\nReviewService"

participant Review as "Review: Review"

participant ReviewRepository as "<<Repository>>\nReviewRepository"

participant "ReviewDb : Review" as ReviewDb

participant Database as "<<Database>>\nDatabase"

participant ReviewResponseMapper as "<<Mapper>>\nReviewResponseMapper"

participant reviewRequestMapper as "<<Mapper>>\nreviewRequestMapper"

Admin -> Dashboard : ChooseViewableReviews()

activate Dashboard

Dashboard -> ChooseViewableReviews : render()

activate ChooseViewableReviews

Admin -> ChooseViewableReviews : getReview()

ChooseViewableReviews -> reviewRequest : GET http://localhost:8080/api/v1/corso/reviews?pageSize=${size}&offset=${(pageNumber - 1) * size}

activate reviewRequest

reviewRequest -> ReviewController : updatePinnedReviewByReviewId(ReviewResponse)

activate ReviewController

ReviewController -> ReviewService : updatePinnedReviewByReviewId()

activate ReviewService


activate reviewRequestMapper


destroy reviewRequest

destroy reviewRequestMapper

activate Review

Review -> ReviewService: Reviews : List<Review>

ReviewService -> ReviewRepository : updatePinnedReviewByReviewId(ReviewResponse)

destroy Review

activate ReviewRepository

loop for each Review in Reviews
    ReviewRepository -> Database : "SELECT * FROM reviews WHERE customer_full_name LIKE concat(:customerFullName,'%') ORDER BY pinned LIMIT :pageSize OFFSET :offset"

end loop

activate Database

Database -> ReviewDB : ReviewDB : List<Review>

deactivate Database

activate ReviewDb

ReviewDb --> ReviewRepository : ReviewDbs : List<Review>

ReviewRepository -> ReviewService : ReviewDbs : List<Review>

destroy ReviewRepository

ReviewService -> ReviewResponseMapper : toReviewResponse(Review)

destroy ReviewDb

activate ReviewResponseMapper

ReviewResponseMapper --> ReviewResponse : List<ReviewResponse>

destroy ReviewResponseMapper

activate ReviewResponse

ReviewResponse --> ReviewService : ReviewResponse : List<ReviewResponse>

ReviewService --> ReviewController : ReviewResponse : List<ReviewResponse>

ReviewController --> reviewRequest : ReviewResponse : List<ReviewResponse>

reviewRequest --> ChooseViewableReviews : ReviewResponse : List<ReviewResponse>

destroy ReviewResponse

@endpuml