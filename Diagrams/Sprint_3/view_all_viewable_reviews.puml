@startuml

title View Pinned Reviews SSD

actor User

participant HomePage as "<<View>>\nHomePage"
participant ReviewController as "<<Controller>>\nReviewController"
participant ReviewService as "<<Service>>\nReviewService"
participant PinnedReviews as "pinnedReviews: List<Review>"
participant ReviewRepository as "<<Repository>>\nReviewRepository"
participant PinnedReviewsResponse as "pinnedReviewsResponse: List<ReviewResponse> toReviewResponse"
participant Database as "<<Database>>\nDatabase"
participant ReviewResponseMapper as "<<Mapper>>\nReviewResponseMapper"

User -> HomePage: ViewPinnedReviews()
activate HomePage

HomePage -> ReviewController: GET /api/v1/corso/reviews/pinned
activate ReviewController

ReviewController -> ReviewService: getPinnedReviews(boolean pinned)
activate ReviewService

ReviewService -> ReviewRepository: getReviewByPinned(boolean pinned)
activate ReviewRepository

ReviewRepository -> Database: SELECT * FROM reviews WHERE pinned = true
activate Database

Database --> ReviewRepository: List<Review>
deactivate Database

ReviewRepository --> PinnedReviews: List<Review>
activate PinnedReviews

PinnedReviews --> ReviewService: getPinnedReviews: List<Review>

destroy ReviewRepository

ReviewService -> ReviewResponseMapper: toReviewResponse(List<Review> reviews)
destroy PinnedReviews
activate ReviewResponseMapper

ReviewResponseMapper --> PinnedReviewsResponse: List<ReviewResponse>
activate PinnedReviewsResponse

PinnedReviewsResponse --> ReviewService: toReviewsResponse: List<ReviewResponse>
destroy ReviewResponseMapper

ReviewService --> ReviewController: pinnedReviewsResponse: List<ReviewResponse>
destroy PinnedReviewsResponse

ReviewController --> HomePage: toReviewsResponse: List<ReviewResponse>
destroy ReviewController

HomePage -> HomePage: render()
deactivate HomePage

@enduml
