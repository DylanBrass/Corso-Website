@startuml
actor User

participant "Order Dashboard" as ODashB

participant "CreateOrderPage" as COP

participant "orderRequest : OrderRequest" as Orq

participant "OrderController" as Oc

participant "orderResponse : OrderResponse" as Orr

participant "OrderService" as Os

participant "order : Order" as O

participant "OrderRepository" as Orep

participant "orderDb : Order" as Odb

participant "Database" as Db

participant "OrderResponseMapper" as OresM

participant "OrderRequestMapper" as OreqM


opt
User -> ODashB : CreateOrder
activate ODashB

ODashB -> COP : render()
activate COP

COP -> Orq : POST /api/v1/corso/orders/customerCreateOrder
activate Orq

Orq -> Oc
activate Oc

Oc -> Os : customerCreateOrder(orderRequest)
activate Os

Os -> OreqM : mapToOrder(orderRequest)
activate OreqM

OreqM -> O: Order

deactivate Orq
deactivate OreqM

activate O

O -> Os : order : Order

Os -> EmailService : sendEmailToAdmins(orderDetails)
activate EmailService
EmailService --> Os
deactivate EmailService

Os -> Orep: save(order)
deactivate O

Orep -> Db: INSERT INTO orders (details) VALUES (:details);
activate Db

Db -> Odb: orderDb : Order
deactivate Db

activate Odb
Odb -> Orep: orderDB : Order

Orep -> Os: orderDB : Order
deactivate Orep
Os -> OresM: mapToOrderResponse(order)
deactivate Odb
activate OresM

OresM --> Orr: OrderResponse
deactivate OresM
activate Orr

Orr --> Os : orderResponse : OrderResponse

Os --> Oc: orderResponse : OrderResponse

Oc --> COP: orderResponse : OrderResponse

deactivate Orr
end opt
@enduml
